{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Build",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "cmake --build build; if ($LASTEXITCODE -ne 0) { Write-Host ''; Write-Host '编译失败，请查看上方错误；按 Enter 关闭终端...' -ForegroundColor Red; [void](Read-Host); exit 1 }"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false,
                "close": true
            }
        }
    ]
}
