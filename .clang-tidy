# TNeuralNetwork 的 clang-tidy 配置（clangd 读的就是这个文件）。
#
# Checks 只列真正有用的检查族，刻意不用 '*'：'*' 会连给别的项目/别的语言写的检查
# （llvmlibc、fuchsia、altera、zircon、objc、openmp…）一起打开，在本仓库全是误报
# ——例如 llvmlibc-implementation-in-namespace 会要求所有实现都写进 __llvm_libc 命名空间。
#
# 下面逐条关掉的检查，数字是在几个编译单元（main / web/main / NumDistinguish / Sample /
# Shuffle / TnRandom / Recorder / DashboardServer）上实测的命中数；拆出 Web 入口后个别
# 计数会略有变化，量级不变：
#   93  modernize-use-trailing-return-type              本项目一律用传统返回类型
#   83  readability-identifier-length                   i / ec / ss 这类短名是刻意的
#   81  cppcoreguidelines-pro-bounds-avoid-unchecked-container-access    热循环必须用 operator[]
#   69  misc-include-cleaner                            要求每个符号都有直接 include，噪声大于收益
#   33  cppcoreguidelines-pro-type-vararg               printf 是本项目既定的控制台输出方式
#   26  modernize-raw-string-literal                    纯口味
#   22  modernize-use-nodiscard                         设计取向，不是缺陷
#   19  cppcoreguidelines-pro-bounds-array-to-pointer-decay   argv / sqlite3 / C API 交互不可避免
#   17  cppcoreguidelines-owning-memory                 要用 gsl::owner，本项目不引 gsl
#   10  readability-uppercase-literal-suffix            0.1f 与 0.1F 之争
#    9  portability-avoid-pragma-once                  头文件统一 #pragma once
#    8  readability-use-concise-preprocessor-directives #if defined(X) 比 #ifdef 更清楚
#    7  misc-non-private-member-variables-in-classes    TrainingOptions 这类配置结构体字段本就该公开
#    7  cppcoreguidelines-non-private-member-variables-in-classes               （上一行的孪生检查）
#    5  cppcoreguidelines-pro-bounds-pointer-arithmetic
#    4  bugprone-easily-swappable-parameters           报的都是名字/类型清楚的相邻参数，改签名不划算
#    2  cppcoreguidelines-pro-bounds-constant-array-index
#    2  cppcoreguidelines-avoid-non-const-global-variables     g_stopRequested 是原子停止标志，故意的
#    1  clang-analyzer-optin.core.EnumCastOutOfRange          唯一一条命中在 MSVC 头文件里（analyzer 的诊断
#                                                            不受 header filter 约束），是纯误报
#        cppcoreguidelines-avoid-magic-numbers               网络维度/训练超参直接用字面量最直观，不引具名常量
Checks: >
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  concurrency-*,
  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-use-anyofallof,
  -readability-math-missing-parentheses,
  -readability-identifier-length,
  -readability-uppercase-literal-suffix,
  -readability-use-concise-preprocessor-directives,
  -readability-function-cognitive-complexity,
  -readability-isolate-declaration,
  -readability-braces-around-statements,
  -readability-redundant-access-specifiers,
#      modernize-*,
#      -modernize-use-trailing-return-type,
  portability-*,
  -portability-avoid-pragma-once,

WarningsAsErrors: ''

# 只报本仓库三个功能目录里的头文件：内置第三方（sqlite3 / httplib）与 MSVC / Windows SDK
# 的头文件都不进报告（AGENTS.md 也要求别动那两个第三方目录）。
HeaderFilterRegex: '[/\\](TNeuralNetworkEngine|record|web)[/\\]'
ExcludeHeaderFilterRegex: '(sqlite3|httplib)'

FormatStyle: file